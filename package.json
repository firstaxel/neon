    "pridepack": "^2.6.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "ultracite": "7.11.0",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "trustedDependencies": [
    "@sentry/cli",
    "core-js",
    "inngest-cli",
    "protobufjs"
  ]
}
