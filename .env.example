# ==============================================================================
# Velocast Environment Variables Template
# ==============================================================================
# Copy this file to .env.local (and/or .env) and set your actual configuration:
#   cp .env.example .env.local
#
# Categories:
# 1. Application & URLs
# 2. Database & Prisma (PostgreSQL / Neon)
# 3. Better Auth & OAuth
# 4. Cloudflare R2 Object Storage (S3 API)
# 5. Google Gemini AI
# 6. Termii (SMS Gateway)
# 7. Paystack (Payments & Subscriptions)
# 8. Email / SMTP (Nodemailer)
# 9. Meta / WhatsApp Cloud API & Webhooks
# 10. Inngest (Background Jobs & Workflows)
# 11. Monitoring & Analytics (PostHog & Sentry)
# 12. Meta CLI Scripts (scripts/)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & URLs
# ------------------------------------------------------------------------------
# App title displayed in browser title and metadata
VITE_APP_TITLE="Velocast"

# Client URL (frontend base URL). Used by Better Auth client, SEO metadata, and email links.
# Format: fully qualified URL with protocol and port (e.g. http://localhost:3000)
VITE_CLIENT_URL="http://localhost:3000"

# Backend server URL override (optional, defaults to same origin)
SERVER_URL="http://localhost:3000"

# Application environment mode ("development" | "production" | "test")
NODE_ENV="development"

# Port for local dev server
PORT=3000

# ------------------------------------------------------------------------------
# 2. Database & Prisma (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Primary PostgreSQL connection string for local development & Prisma migrations.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Neon Postgres: postgresql://USER:PASSWORD@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/velocast?schema=public"

# Production PostgreSQL database connection string (used when PROD=true)
PROD_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/velocast_prod?schema=public"

# ------------------------------------------------------------------------------
# 3. Better Auth & OAuth
# ------------------------------------------------------------------------------
# Secret key used by Better Auth to encrypt session cookies and sign authentication tokens.
# Generate with: bunx --bun @better-auth/cli secret
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"

# Canonical base URL for Better Auth backend handlers (e.g. http://localhost:3000)
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth credentials for social sign-in (Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 4. Cloudflare R2 Storage (S3-compatible)
# ------------------------------------------------------------------------------
# Cloudflare Account ID (found in Cloudflare Dashboard URL or R2 overview)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"

# Cloudflare R2 API Token Access Key ID
CLOUDFLARE_ACCESS_KEY_ID="your-r2-access-key-id"

# Cloudflare R2 API Token Secret Access Key
CLOUDFLARE_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# R2 Bucket name where contact images and parse jobs are stored (default: bulk-messaging)
R2_BUCKET_NAME="bulk-messaging"

# Optional public bucket URL or custom domain for accessing uploaded files
R2_PUBLIC_URL="https://pub-your-bucket-id.r2.dev"

# ------------------------------------------------------------------------------
# 5. Google Gemini AI
# ------------------------------------------------------------------------------
# Google AI Studio API key used for OCR contact sheet parsing and message safety checking
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ------------------------------------------------------------------------------
# 6. Termii (SMS Gateway)
# ------------------------------------------------------------------------------
# Termii API key (found in Termii dashboard: https://termii.com)
TERMII_API_KEY="your-termii-api-key"

# Termii Secret key
TERMII_SECRET_KEY="your-termii-secret-key"

# Default Termii Sender ID for outgoing SMS (default: MessageDsk)
TERMII_SENDER_ID="MessageDsk"

# Platform-level shared SMS Sender ID used during onboarding
PLATFORM_SMS_SENDER_ID="Velocast"

# ------------------------------------------------------------------------------
# 7. Paystack (Payments & Subscriptions)
# ------------------------------------------------------------------------------
# Paystack public key for frontend checkout modal (pk_test_... or pk_live_...)
PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"

# Paystack secret key for backend API requests and webhook signature verification (sk_test_... or sk_live_...)
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"

# Paystack Plan Codes (created in Paystack Dashboard -> Subscriptions -> Plans)
PAYSTACK_PLAN_STARTER="PLN_starter_code_here"
PAYSTACK_PLAN_GROWTH="PLN_growth_code_here"
PAYSTACK_PLAN_PRO="PLN_pro_code_here"

# ------------------------------------------------------------------------------
# 8. Email / SMTP (Nodemailer)
# ------------------------------------------------------------------------------
# SMTP Server hostname (e.g. smtp.gmail.com, smtp.resend.com, smtp.mailgun.org)
SMTP_HOST="smtp.gmail.com"

# SMTP Port (587 for STARTTLS, 465 for SSL)
SMTP_PORT="587"

# SMTP Username / email address
SMTP_USER="your-email@example.com"

# SMTP Password / app-specific password
SMTP_PASS="your-smtp-app-password"

# Set to "true" for SSL (port 465), or "false" for STARTTLS (port 587)
SMTP_SECURE="false"

# Sender address shown on outgoing emails (e.g. magic links, verification, password resets)
EMAIL_FROM="Velocast <no-reply@velocast.local>"

# ------------------------------------------------------------------------------
# 9. Meta / WhatsApp Cloud API & Webhooks
# ------------------------------------------------------------------------------
# Meta System User permanent access token with whatsapp_business_messaging & whatsapp_business_management
META_ACCESS_TOKEN="EAAG...your_meta_system_access_token"

# Meta WhatsApp Business Phone Number ID
META_PHONE_NUMBER_ID="your_meta_phone_number_id"

# Meta WhatsApp Business Account (WABA) ID
META_WABA_ID="your_meta_waba_id"

# Meta Graph API version (default: v22.0)
META_API_VERSION="v22.0"

# WhatsApp Webhook challenge verify token (configured in Meta App Dashboard -> WhatsApp -> Configuration)
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_verify_token"

# WhatsApp Webhook HMAC Secret (App Secret used to verify sha256 x-hub-signature-256)
WHATSAPP_WEBHOOK_SECRET="your_meta_app_secret"

# Meta WhatsApp Consent Pre-screen template name (default: Velocast_consent_v1)
PRESCREEN_TEMPLATE_NAME="Velocast_consent_v1"

# Meta WhatsApp Consent Pre-screen template language (default: en)
PRESCREEN_TEMPLATE_LANG="en"

# ------------------------------------------------------------------------------
# 10. Inngest (Background Jobs & Workflows)
# ------------------------------------------------------------------------------
# Inngest event sending key (for production or Inngest Cloud)
INNGEST_EVENT_KEY="your-inngest-event-key"

# Inngest signing key (used to verify incoming webhook requests at /api/inngest)
INNGEST_SIGNING_KEY="signkey-test-your-signing-key"

# ------------------------------------------------------------------------------
# 11. Monitoring & Analytics (PostHog & Sentry)
# ------------------------------------------------------------------------------
# PostHog Project API Key (posthog.com -> Project Settings). Leave blank to disable.
VITE_POSTHOG_KEY=""

# PostHog host URL (default: https://us.i.posthog.com or https://eu.i.posthog.com)
VITE_POSTHOG_HOST="https://us.i.posthog.com"

# Sentry DSN for error and performance tracking. Leave blank to disable Sentry.
VITE_SENTRY_DSN=""

# ------------------------------------------------------------------------------
# 12. Meta CLI Scripts (Optional - scripts/ directory)
# ------------------------------------------------------------------------------
# Meta System User token used by standalone scripts in scripts/
META_SYSTEM_TOKEN=""

# Meta Business Portfolio ID (for scripts/debug-meta-ids.ts)
META_BUSINESS_ID=""

# Dry run flag for scripts/submit-meta-templates.ts ("true" or "false")
DRY_RUN="false"
