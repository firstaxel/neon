{
  "name": "church",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && mkdir -p .output/server/ && cp instrument.server.mjs .output/server/instrument.server.mjs",
    "check": "ultracite check",
    "db:dev": "dotenv -e .env -- prisma dev",
    "db:generate": "dotenv -e .env -- prisma generate",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:migrate:prod": "PROD=true dotenv -e .env -- prisma migrate deploy",
    "db:push": "dotenv -e .env -- prisma db push",
    "db:reset": "dotenv -e .env -- prisma migrate reset",
    "db:reset:prod": "PROD=true dotenv -e .env -- prisma migrate reset",
    "db:seed": "dotenv -e .env -- prisma db seed",
    "db:studio": "dotenv -e .env -- prisma studio",
    "dev": "dotenv -e .env -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
    "email:dev": "email dev",
    "fix": "ultracite fix",
    "format": "biome format",
    "inngest-cli": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "lint": "biome lint",
    "post-cta-init": "bunx --bun create-db@latest --user-agent tanstack/tsrouter",
    "prepare": "husky",
    "preview": "vite preview",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@base-ui/react": "^1.8.0",
    "@brvhprince/termii-js": "^3.0.0",
    "@davidbolaji/termii-node": "^1.0.3",
    "@faker-js/faker": "^10.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@google/generative-ai": "^0.24.1",
    "@orpc/client": "^2.0.0-beta.33",
    "@orpc/json-schema": "^2.0.0-beta.33",
    "@orpc/openapi": "^2.0.0-beta.33",
    "@orpc/server": "^2.0.0-beta.33",
    "@orpc/tanstack-query": "^2.0.0-beta.33",
    "@orpc/zod": "^2.0.0-beta.33",
    "@posthog/react": "^1.10.5",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/tanstackstart-react": "^10.73.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/match-sorter-utils": "^9.1.2",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
